# Configuración de DBMaster Studio

# Clave secreta para JWT (cambiar en producción)
JWT_SECRET=your-secret-key-change-in-production

# Clave de administrador para generar contraseñas temporales
ADMIN_KEY=admin-secret-key-change-in-production

# API Key de Google Gemini (opcional, para funcionalidad de IA)
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Configuration (para sistema de administración web)
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Configuración de Correo SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=DBMaster Studio <noreply@dbmaster.studio>

# Entorno
NODE_ENV=development
PORT=3000